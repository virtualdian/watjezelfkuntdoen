---
import '../styles/global.css';
import Radar from '../components/Radar.astro';
import { buildRadar } from '../lib/layout.js';
import { rings } from '../data/radar.js';

const { blips, perSegment, telling, totaal } = buildRadar();
const detailData = blips.map((b) => ({
  nr: b.nr,
  titel: b.titel,
  tekst: b.tekst,
  waarom: b.waarom || null,
  links: b.links || [],
  ring: b.ring,
  ringNaam: rings.find((r) => r.id === b.ring).naam,
  segment: perSegment.find((s) => s.id === b.segment).naam,
}));
---

<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Wat je zelf kunt doen, een duurzaamheidsradar van thuis</title>
    <meta
      name="description"
      content={`${totaal} dingen die ik thuis doe om duurzamer te leven. Geen lijstje met tips, maar wat er echt in huis, in de tuin en op de rekening gebeurt.`}
    />
    <meta name="theme-color" content="#26402f" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='15' fill='%2326402f'/%3E%3Ccircle cx='16' cy='16' r='10' fill='none' stroke='%23c6d9b0' stroke-width='2'/%3E%3Ccircle cx='16' cy='16' r='5' fill='none' stroke='%23c6d9b0' stroke-width='2'/%3E%3C/svg%3E" />
  </head>

  <body>
    <header class="kop">
      <div class="omhulsel kop-binnen">
        <a class="merk" href="#top">
          <span class="merk-ring" aria-hidden="true"></span>
          Wat je zelf kunt doen
        </a>
        <nav>
          <a href="#radar">De radar</a>
          <a href="#waarom">Maakt het uit?</a>
          <a href="#over">Over mij</a>
        </nav>
      </div>
    </header>

    <main id="top">
      <section class="held">
        <div class="omhulsel held-binnen">
          <p class="bovenlabel">Een privé duurzaamheidsradar</p>
          <h1>Het maakt<br />wél uit.</h1>
          <p class="lead">
            Bijna iedereen die ik spreek is radeloos. &ldquo;Wat ik doe maakt toch niets
            uit, wat kan ik nou helemaal zelf doen?&rdquo; Dit is mijn antwoord: {totaal} dingen
            die ik thuis daadwerkelijk doe. Geen lijstje met tips van internet, maar wat er
            bij mij echt in de keuken, in de tuin en op de bankrekening gebeurt. Niet omdat
            ik het allemaal goed doe, maar omdat ik hoop dat je er één ding uit meeneemt.
          </p>
          <p class="lead">
            En het gekke is: bijna niets ervan voelt als inleveren. Minder kopen betekent
            meer sparen en sneller aflossen, en dat betekent uiteindelijk vrije tijd. Tijd
            is het meest schaarse goed dat je hebt.
          </p>
          <p class="held-knoppen">
            <a class="knop" href="#radar">Bekijk de radar</a>
            <a class="knop knop-licht" href="#waarom">Waarom het wél uitmaakt</a>
          </p>
        </div>
      </section>

      <section id="radar" class="radar-sectie">
        <div class="omhulsel">
          <p class="bovenlabel">De radar</p>
          <h2>Acht thema&rsquo;s, vier (jaar)ringen</h2>
          <p class="lead">
            In het midden staat wat je vandaag nog kunt doen: dat kost je niets. Hoe verder
            naar buiten, hoe meer het van je vraagt. De buitenste ring is de schors: waar ik
            bewust afscheid van heb genomen. Tik op een stip, of blader door de lijst
            eronder.
          </p>
        </div>

        <div class="radar-blok">
          <div class="omhulsel">
            <Radar />
          </div>
        </div>

        <div class="omhulsel">
          <div class="detail" id="detail" aria-live="polite">
            <p class="detail-leeg">
              Tik op een stip in de radar, of op een item in de lijst hieronder.
            </p>
          </div>
        </div>
      </section>

      <section class="lijst-sectie">
        <div class="omhulsel">
          <p class="bovenlabel">Alles op een rij</p>
          <h2>Alle {totaal} dingen</h2>
          <div class="kolommen">
            {perSegment.map((seg) => (
              <div class="segment-kaart">
                <h3>{seg.naam}</h3>
                {seg.ringen.map((ring) => (
                  <div class="ringgroep">
                    <p class={`ringkop ringkop-${ring.id}`}>{ring.naam}</p>
                    <ul>
                      {ring.items.map((item) => (
                        <li>
                          <button type="button" class="item-knop" data-nr={item.nr}>
                            <span class="item-nr">{item.nr}</span>
                            <span>{item.titel}</span>
                          </button>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="waarom" class="waarom">
        <div class="omhulsel waarom-binnen">
          <p class="bovenlabel">Maakt het uit?</p>
          <h2>&ldquo;Wat ik doe maakt toch niets uit&rdquo;</h2>
          <div class="waarom-kolommen">
            <div>
              <p>
                Dat hoor je overal, en het is begrijpelijk. Je leest over smeltend ijs en
                afbrandende bossen, en dan sta jij in de supermarkt te twijfelen over een
                pak melk. Dat voelt belachelijk klein.
              </p>
              <p>
                Maar de redenering klopt niet. Niemand vraagt jou om het klimaat in je
                eentje te repareren. Waar het om gaat is dat vrijwel alles op deze radar
                een <strong>keuze in een systeem</strong> is. Biologisch kopen verandert
                niet de wereld, maar het verandert wél wat de boer volgend jaar durft te
                zaaien. Overstappen naar een andere bank verandert waar jouw geld gaat
                liggen. Dat werkt alleen als genoeg mensen het doen, en dat is precies
                waarom het uitmaakt dat jij het doet.
              </p>
            </div>
            <div>
              <p>
                En dan het tweede stuk. Duurzaam leven wordt altijd gebracht als iets wat je
                inlevert. Bij mij werkt het andersom. Minder kopen betekent meer sparen en
                sneller aflossen. Zelf koken van je restjes is lekkerder. Je eigen tomaten
                smaken beter. Fietsen naar je werk is de fijnste drie kwartier van de dag.
              </p>
              <p>
                Wat je terugkrijgt is tijd, en tijd is het enige dat je nergens kunt
                bijkopen. Dat is geen offer. Dat is winst.
              </p>
              <p class="waarom-nb">
                In dezelfde geest, en veel beter opgeschreven:
                <em>Intentioneel leven</em> van Ernst-Jan Pfauth.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section id="over" class="over">
        <div class="omhulsel over-binnen">
          <div>
            <p class="bovenlabel">Over mij</p>
            <h2>Ik ben geen expert</h2>
            <p>
              Ik ben Dian, en ik woon met mijn gezin in een gewoon huis in Nederland. Alles
              op deze radar doe ik zelf, of heb ik zelf geprobeerd. Waar ik iets niet doe,
              staat dat er ook bij, inclusief het feit dat ik heel af en toe vlieg.
            </p>
            <p>
              Dit is bedoeld om je te inspireren, niet om je de les te lezen. Het is
              nadrukkelijk niet de enige waarheid en zeker niet het einde van het lijstje.
              Ik weet vrij zeker dat ik een aantal dingen beter kan doen, en er staan vast
              zaken tussen waar iemand anders een betere oplossing voor heeft gevonden. Ik
              leer graag bij, dus weet je iets wat hier nog niet staat: laat het me weten.
            </p>
            <p>
              Deze site is een privéproject. Hij staat volledig los van mijn werkgever, is
              op eigen tijd gemaakt en gebruikt geen materiaal van welke organisatie dan
              ook. Er wordt niets aan verdiend en er staat geen advertentie op. De bedrijven
              die ik noem betalen daar niet voor; het is gewoon wat er bij mij in de kast
              staat.
            </p>
            <p>
              Mis je iets, of doe je thuis iets wat hier nog niet staat? De site is open
              source. Stuur gerust een pull request.
            </p>
            <p>
              <a class="knop" href="#" data-koffie>Trakteer me op een koffie</a>
            </p>
          </div>
          <aside class="colofon">
            <h3>Colofon</h3>
            <p>
              Deze radar telt {totaal} items, verdeeld over acht thema&rsquo;s en vier ringen:
              {telling.map((r, i) => (
                <>{i > 0 ? ', ' : ''}<strong>{r.aantal}</strong> × {r.kort.toLowerCase()}</>
              ))}.
            </p>
            <p>
              Waar ik een getal of een bewering noem, hoort daar een bron bij. Een paar
              items wachten nog op die onderbouwing en zijn daarom voorzichtig geformuleerd.
              Liever iets minder stellig dan iets wat niet klopt.
            </p>
          </aside>
        </div>
      </section>
    </main>

    <footer class="voet">
      <div class="omhulsel">
        <p>Wat je zelf kunt doen. Een privéproject, gemaakt met veel groen en weinig javascript.</p>
      </div>
    </footer>

    <script type="application/json" id="radar-data" set:html={JSON.stringify(detailData)} />

    <script>
      const data = JSON.parse(document.getElementById('radar-data').textContent);
      const perNr = new Map(data.map((d) => [String(d.nr), d]));
      const detail = document.getElementById('detail');
      const svg = document.querySelector('.radar');
      const blips = [...document.querySelectorAll('.blip')];
      const itemKnoppen = [...document.querySelectorAll('.item-knop')];
      const smal = () => window.matchMedia('(max-width: 760px)').matches;

      function el(tag, klasse, tekst) {
        const n = document.createElement(tag);
        if (klasse) n.className = klasse;
        if (tekst) n.textContent = tekst;
        return n;
      }

      function toon(nr) {
        const d = perNr.get(String(nr));
        if (!d) return;

        detail.textContent = '';

        const sluit = el('button', 'detail-sluit', 'Sluiten');
        sluit.type = 'button';
        sluit.addEventListener('click', () => {
          detail.classList.remove('open');
          blips.forEach((b) => b.classList.remove('actief'));
          itemKnoppen.forEach((k) => k.classList.remove('actief'));
        });
        detail.append(sluit);

        const kruimel = el('p', 'detail-kruimel');
        kruimel.append(el('span', 'detail-nr', String(d.nr)));
        kruimel.append(el('span', null, `${d.segment} · ${d.ringNaam}`));
        detail.append(kruimel);

        detail.append(el('h3', null, d.titel));
        detail.append(el('p', 'detail-tekst', d.tekst));

        if (d.waarom) {
          const meer = el('details', 'detail-waarom');
          meer.append(el('summary', null, 'Waarom dit uitmaakt'));
          d.waarom.split('\n\n').forEach((alinea) => meer.append(el('p', null, alinea)));
          detail.append(meer);
        }

        if (d.links.length) {
          const rij = el('p', 'detail-links');
          d.links.forEach((l, i) => {
            if (i > 0) rij.append(document.createTextNode(' · '));
            const a = el('a', null, l.tekst);
            a.href = l.url;
            a.target = '_blank';
            a.rel = 'noopener noreferrer';
            rij.append(a);
          });
          detail.append(rij);
        }

        detail.classList.add('open');
        blips.forEach((b) => b.classList.toggle('actief', b.dataset.nr === String(nr)));
        itemKnoppen.forEach((k) => k.classList.toggle('actief', k.dataset.nr === String(nr)));
      }

      blips.forEach((b) => {
        b.addEventListener('click', () => toon(b.dataset.nr));
        b.addEventListener('mouseenter', () => {
          if (!smal()) toon(b.dataset.nr);
        });
        b.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            toon(b.dataset.nr);
          }
        });
        b.addEventListener('focus', () => toon(b.dataset.nr));
      });

      itemKnoppen.forEach((k) => {
        k.addEventListener('click', () => {
          toon(k.dataset.nr);
          if (!smal()) {
            document.getElementById('radar').scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      });

      // Ringen filteren via de legenda
      let filter = null;
      document.querySelectorAll('[data-ringfilter]').forEach((knop) => {
        knop.addEventListener('click', () => {
          const ring = knop.dataset.ringfilter;
          filter = filter === ring ? null : ring;
          svg.classList.toggle('gefilterd', filter !== null);
          document.querySelectorAll('[data-ringfilter]').forEach((k) => {
            const aan = k.dataset.ringfilter === filter;
            k.classList.toggle('aan', aan);
            k.setAttribute('aria-pressed', String(aan));
          });
          blips.forEach((b) =>
            b.classList.toggle('zichtbaar', filter === null || b.dataset.ring === filter)
          );
          document.querySelectorAll('.wiggen path').forEach((p) => {
            if (filter && p.dataset.ring === filter) p.setAttribute('data-actief', '');
            else p.removeAttribute('data-actief');
          });
        });
      });

      document.querySelector('[data-koffie]')?.addEventListener('click', (e) => {
        e.preventDefault();
        alert('Hier komt de Buy Me a Coffee-knop zodra de pagina is aangemaakt.');
      });
    </script>

    <style>
      .kop {
        border-bottom: 1px solid rgba(22, 38, 28, 0.1);
        background: var(--wit);
        position: sticky;
        top: 0;
        z-index: 30;
      }

      .kop-binnen {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-top: 0.9rem;
        padding-bottom: 0.9rem;
      }

      .merk {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        font-family: var(--serif);
        font-weight: 700;
        font-size: 1.05rem;
        color: var(--inkt);
        text-decoration: none;
      }

      .merk-ring {
        width: 22px;
        height: 22px;
        flex: none;
        border-radius: 50%;
        background: radial-gradient(
          circle,
          var(--bos) 0 22%,
          var(--ring-3) 22% 42%,
          var(--bos) 42% 60%,
          var(--ring-2) 60% 78%,
          var(--schors-diep) 78% 100%
        );
      }

      .kop nav {
        display: flex;
        gap: 1.4rem;
        font-size: 0.92rem;
      }

      .kop nav a {
        color: var(--grijsgroen);
        text-decoration: none;
      }

      .kop nav a:hover {
        color: var(--inkt);
      }

      @media (max-width: 640px) {
        .kop-binnen {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.5rem;
        }

        .merk {
          font-size: 1rem;
        }

        .kop nav {
          gap: 0.4rem;
          font-size: 0.85rem;
          margin-left: -0.6rem;
        }

        /* Ruimere aanraakvlakken op een telefoon */
        .kop nav a {
          display: block;
          padding: 0.45rem 0.6rem;
        }
      }

      .held {
        background: var(--room);
        padding: clamp(2.5rem, 8vw, 7rem) 0 clamp(2.5rem, 6vw, 5rem);
        border-bottom: 1px solid rgba(22, 38, 28, 0.08);
      }

      .held-binnen {
        max-width: 900px;
      }

      .held h1 {
        margin-bottom: 1.4rem;
      }

      .held-knoppen {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
        margin-top: 2rem;
      }

      .radar-sectie {
        padding: clamp(2.5rem, 7vw, 5.5rem) 0;
      }

      .radar-blok {
        margin: 2.5rem 0 0;
      }

      .lijst-sectie {
        background: var(--room);
        border-top: 1px solid rgba(22, 38, 28, 0.08);
        border-bottom: 1px solid rgba(22, 38, 28, 0.08);
        padding: clamp(2.5rem, 7vw, 5.5rem) 0;
      }

      .kolommen {
        columns: 3 300px;
        column-gap: 2.2rem;
        margin-top: 2.5rem;
      }

      .segment-kaart {
        break-inside: avoid;
        background: var(--wit);
        border: 1px solid rgba(22, 38, 28, 0.1);
        border-radius: 14px;
        padding: 1.3rem 1.4rem;
        margin-bottom: 1.4rem;
      }

      .segment-kaart h3 {
        margin-bottom: 1rem;
        font-size: 1.3rem;
      }

      .ringgroep + .ringgroep {
        margin-top: 1.1rem;
      }

      .ringkop {
        font-size: 0.72rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        font-weight: 700;
        color: var(--grijsgroen);
        margin: 0 0 0.4rem;
        padding-left: 0.6rem;
        border-left: 4px solid var(--ring-2);
      }

      .ringkop-vandaag { border-color: var(--blad); }
      .ringkop-vervang { border-color: var(--ring-3); }
      .ringkop-investeer { border-color: var(--bos-mid); }
      .ringkop-laat { border-color: var(--schors-diep); }

      .segment-kaart ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .item-knop {
        display: flex;
        gap: 0.6rem;
        align-items: baseline;
        width: 100%;
        text-align: left;
        background: none;
        border: 0;
        border-radius: 8px;
        padding: 0.5rem 0.4rem;
        font: inherit;
        font-size: 0.95rem;
        line-height: 1.4;
        color: var(--inkt);
        cursor: pointer;
      }

      .item-knop:hover,
      .item-knop.actief {
        background: var(--room-diep);
      }

      .item-nr {
        flex: none;
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--bos-mid);
        min-width: 1.6em;
      }

      .waarom {
        padding: clamp(3rem, 8vw, 6rem) 0;
        background: var(--bos);
        color: var(--room);
      }

      .waarom h2 {
        color: var(--room);
      }

      .waarom .bovenlabel {
        color: var(--sage);
      }

      .waarom-binnen {
        max-width: 1000px;
      }

      .waarom-kolommen {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2.5rem;
        margin-top: 1.5rem;
      }

      .waarom-kolommen p {
        color: rgba(251, 249, 243, 0.86);
      }

      .waarom-kolommen strong {
        color: var(--wit);
      }

      .waarom-nb {
        font-size: 0.9rem;
        color: var(--sage) !important;
        border-top: 1px solid rgba(251, 249, 243, 0.2);
        padding-top: 1rem;
      }

      .over {
        padding: clamp(3rem, 8vw, 6rem) 0;
      }

      .over-binnen {
        display: grid;
        grid-template-columns: minmax(0, 1.5fr) minmax(260px, 1fr);
        gap: 3rem;
        align-items: start;
      }

      @media (max-width: 820px) {
        .over-binnen {
          grid-template-columns: 1fr;
          gap: 2rem;
        }
      }

      .colofon {
        background: var(--room);
        border: 1px solid rgba(22, 38, 28, 0.12);
        border-radius: 14px;
        padding: 1.4rem 1.5rem;
        font-size: 0.92rem;
        color: var(--grijsgroen);
      }

      .colofon h3 {
        font-size: 1.05rem;
        margin-bottom: 0.6rem;
        color: var(--inkt);
      }

      .voet {
        border-top: 1px solid rgba(22, 38, 28, 0.1);
        padding: 2rem 0;
        font-size: 0.88rem;
        color: var(--grijsgroen);
      }
    </style>
  </body>
</html>
