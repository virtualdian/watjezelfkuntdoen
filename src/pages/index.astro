---
import { execSync } from 'node:child_process';
import '../styles/global.css';
import Radar from '../components/Radar.astro';
import { buildRadar } from '../lib/layout.js';
import { rings } from '../data/radar.js';

// Datum van de laatste commit, zodat "laatst bijgewerkt" vanzelf meeloopt.
let bijgewerkt;
try {
  bijgewerkt = new Date(execSync('git log -1 --format=%cI', { encoding: 'utf8' }).trim());
  if (Number.isNaN(bijgewerkt.getTime())) throw new Error('geen datum');
} catch {
  bijgewerkt = new Date();
}
const bijgewerktKort = `${String(bijgewerkt.getMonth() + 1).padStart(2, '0')}/${bijgewerkt.getFullYear()}`;
const bijgewerktISO = bijgewerkt.toISOString().slice(0, 10);

const canoniek = new URL(Astro.url.pathname, Astro.site).href;
const deelPlaatje = new URL(`${import.meta.env.BASE_URL}og.png`.replace(/\/+/g, '/'), Astro.site)
  .href;

const { blips, perSegment, telling, totaal } = buildRadar();

const deelTekst = `${totaal} dingen die ik thuis doe om duurzamer te leven. Van een regenton tot je pensioen, gesorteerd naar wat het je kost.`;

const detailData = blips.map((b) => ({
  nr: b.nr,
  titel: b.titel,
  tekst: b.tekst,
  waarom: b.waarom || null,
  links: b.links || [],
  ring: b.ring,
  ringNaam: rings.find((r) => r.id === b.ring).naam,
  segment: perSegment.find((s) => s.id === b.segment).naam,
}));

// De vijf met de meeste impact. Verwijst per stuk naar een item op de radar,
// zodat de nummers vanzelf meelopen als er items bijkomen.
const zoek = (titel) => {
  const blip = blips.find((b) => b.titel === titel);
  if (!blip) throw new Error(`Top 5 verwijst naar onbekend item: ${titel}`);
  return blip.nr;
};

const topVijf = [
  {
    nr: zoek('Dakisolatie'),
    kop: 'Isoleer je huis',
    cijfer: '2.000 kg per jaar',
    tekst:
      'Een slecht geïsoleerde hoekwoning naar goed geïsoleerd scheelt zo’n 2.000 kg CO₂ per jaar. Verreweg de grootste enkele maatregel die er is, en meteen de lastigste: je moet het huis ervoor bezitten en je moet het kunnen betalen. Dak, spouw, vloer, en daarna pas een warmtepomp.',
  },
  {
    nr: zoek('Fiets naar je werk'),
    kop: 'Laat de auto vaker staan',
    cijfer: '1.100 kg per jaar',
    tekst:
      'Halveer je autogebruik door te fietsen, het ov te pakken of te carpoolen, en je zit al op ongeveer 1.100 kg per jaar. Dit is de op één na grootste, en je hebt er niemands toestemming voor nodig.',
  },
  {
    nr: zoek('Zet de thermostaat een tandje lager'),
    kop: 'Stook slimmer',
    cijfer: '700 kg per jaar',
    tekst:
      'Thermostaat lager, korter douchen, niet stoken in kamers waar niemand is. Samen zo’n 700 kg per jaar, en het kost je geen cent. Sterker nog, het levert geld op.',
  },
  {
    nr: zoek('Koop minder, en win tijd'),
    kop: 'Koop minder spullen',
    cijfer: '340 kg per persoon',
    tekst:
      'Lenen, tweedehands kopen en gewoon minder nieuw aanschaffen komt op ongeveer 340 kg per persoon per jaar, dus ruim 700 kg voor een gemiddeld huishouden.',
  },
  {
    nr: zoek('Fors minder vlees'),
    kop: 'Eet minder vlees en zuivel',
    cijfer: '330 kg per persoon',
    tekst:
      'Van zes keer per week vlees naar één keer scheelt zo’n 330 kg per persoon per jaar. Eerlijk gezegd minder dan ik zelf dacht, en nog steeds een van de makkelijkste knoppen die er is: je hoeft er niets voor aan te schaffen.',
  },
];

const praatNr = zoek('Praat erover');
const vliegNr = zoek('Vliegen');
const geldNr = zoek('Stap over naar een duurzame bank');

// Hoeveel items zijn niet afhankelijk van een eigen huis of tuin?
const zonderEigenHuis = telling
  .filter((r) => r.id === 'vandaag' || r.id === 'vervang')
  .reduce((som, r) => som + r.aantal, 0);
---

<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Wat je zelf kunt doen, een duurzaamheidsradar van thuis</title>
    <meta name="description" content={deelTekst} />
    <meta name="theme-color" content="#26402f" />

    <link rel="canonical" href={canoniek} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Wat je zelf kunt doen" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:url" content={canoniek} />
    <meta property="og:title" content="Wat je zelf kunt doen" />
    <meta property="og:description" content={deelTekst} />
    <meta property="og:image" content={deelPlaatje} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Een boomschijf met jaarringen, waarin elke stip iets is wat je zelf kunt doen." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Wat je zelf kunt doen" />
    <meta name="twitter:description" content={deelTekst} />
    <meta name="twitter:image" content={deelPlaatje} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='15' fill='%2326402f'/%3E%3Ccircle cx='16' cy='16' r='10' fill='none' stroke='%23c6d9b0' stroke-width='2'/%3E%3Ccircle cx='16' cy='16' r='5' fill='none' stroke='%23c6d9b0' stroke-width='2'/%3E%3C/svg%3E" />
  </head>

  <body>
    <header class="kop">
      <div class="omhulsel kop-binnen">
        <a class="merk" href="#top">
          <span class="merk-ring" aria-hidden="true"></span>
          Wat je zelf kunt doen
        </a>
        <nav>
          <a href="#radar">De radar</a>
          <a href="#top5">Top 5</a>
          <a href="#waarom">Maakt het uit?</a>
          <a href="#over">Over mij</a>
        </nav>
      </div>
    </header>

    <main id="top">
      <section class="held">
        <div class="omhulsel held-binnen">
          <p class="bovenlabel">Een privé duurzaamheidsradar</p>
          <h1>Het maakt<br />wél uit.</h1>
          <p class="lead">
            &ldquo;Wat ik doe maakt toch niets uit.&rdquo; Die zin hoor ik bijna wekelijks.
            Meestal op een verjaardag, meestal van iemand die zich er wel degelijk zorgen
            over maakt.
          </p>
          <p class="lead">
            Dit is mijn antwoord: {totaal} dingen die ik thuis doe. Geen tips die ik ergens
            heb gelezen, maar wat er bij mij in de keuken staat, in de tuin groeit en van
            mijn rekening af gaat. Ik doe het niet allemaal goed. Er staat ook op wat ik heb
            laten liggen.
          </p>
          <p class="lead">
            En het rare is dat bijna niets ervan voelt als inleveren. Minder kopen is vrij
            letterlijk minder werken. Verderop reken ik het voor.
          </p>
          <p class="held-knoppen">
            <a class="knop" href="#radar">Bekijk de radar</a>
            <a class="knop knop-licht" href="#waarom">Waarom het wél uitmaakt</a>
          </p>
        </div>
      </section>

      <section id="radar" class="radar-sectie">
        <div class="omhulsel">
          <p class="bovenlabel">De radar</p>
          <h2>Acht thema&rsquo;s, vier (jaar)ringen</h2>
          <p class="lead">
            In het midden staat wat je vandaag nog kunt doen: dat kost je niets. Hoe verder
            naar buiten, hoe meer het van je vraagt. De buitenste ring is de schors: waar ik
            bewust afscheid van heb genomen. Tik op een stip, of blader door de lijst
            eronder.
          </p>
        </div>

        <div class="radar-blok">
          <div class="omhulsel">
            <Radar />
          </div>
        </div>

        <div class="omhulsel">
          <p class="bijgewerkt">
            Laatst bijgewerkt <time datetime={bijgewerktISO}>{bijgewerktKort}</time>
          </p>
          <div class="detail" id="detail" aria-live="polite">
            <p class="detail-leeg">
              Tik op een stip in de radar, of op een item in de lijst hieronder.
            </p>
          </div>
        </div>
      </section>

      <section id="top5" class="topvijf">
        <div class="omhulsel">
          <p class="bovenlabel">Als je maar vijf dingen doet</p>
          <h2>De vijf met de meeste impact</h2>
          <p class="lead">
            {totaal} items is veel. En nee, ze wegen niet even zwaar.
          </p>
          <p class="lead">
            Ik had deze lijst eerst op gevoel gesorteerd. Toen zocht ik de cijfers op bij
            Milieu Centraal en bleek ik er flink naast te zitten. Ik dacht dat vaker de fiets
            pakken in plaats van de auto het meeste zou opleveren. Je huis isoleren doet
            bijna het dubbele.
          </p>
          <p class="lead">Dus de getallen staan er nu gewoon bij.</p>

          <ol class="topvijf-lijst">
            {topVijf.map((t, i) => (
              <li>
                <span class="topvijf-rang">{i + 1}</span>
                <div>
                  <h3>
                    <button type="button" class="item-knop topvijf-knop" data-nr={t.nr}>
                      {t.kop}
                      <span class="topvijf-nr">nr. {t.nr}</span>
                    </button>
                  </h3>
                  <p class="topvijf-cijfer">{t.cijfer}</p>
                  <p>{t.tekst}</p>
                </div>
              </li>
            ))}
          </ol>

          <div class="topvijf-na">
            <h3>Drie die er bewust niet bij staan</h3>
            <p>
              <button type="button" class="item-knop tekstknop" data-nr={vliegNr}>
                Vliegen
              </button>, omdat het cijfer volledig afhangt van waar je heen gaat. Een
              citytrip naar Berlijn met de trein in plaats van het vliegtuig scheelt 400 kg
              voor twee personen. Maar één retourvlucht naar Bangkok of New York is 1.800 tot
              2.200 kg per persoon. In je eentje dus evenveel als het isoleren van een heel
              huis oplevert, en met z’n vieren meer dan alles op deze lijst bij elkaar. Vlieg
              je, dan is dit met afstand je grootste knop. Vlieg je niet, dan telt hij
              helemaal niet mee. Daarom past hij niet in een ranglijst.
            </p>
            <p>
              <button type="button" class="item-knop tekstknop" data-nr={geldNr}>
                Je geld verhuizen
              </button>, omdat het niet in deze rekenwijze past. Zo’n lijst rekent jouw eigen
              verbruik door, en je spaargeld is geen verbruik. Het effect loopt via waar
              banken en pensioenfondsen dat geld in stoppen, en dat laat zich niet in kilo’s
              per huishouden uitdrukken. Het kost je een half uur en het werkt jarenlang
              door.
            </p>
            <p>
              <button type="button" class="item-knop tekstknop" data-nr={praatNr}>
                Erover praten
              </button>, om dezelfde reden. Het verandert je eigen uitstoot nauwelijks, maar
              wel die van iedereen om je heen, en dat laat zich niet uitrekenen.
            </p>
            <p class="bron">
              Cijfers: <a href="https://www.milieucentraal.nl/klimaat-en-aarde/klimaatverandering/klimaatklappers/" target="_blank" rel="noopener noreferrer">Klimaatklappers van Milieu Centraal</a>.
              Een gemiddeld Nederlands huishouden zit op ongeveer 16.500 kg CO₂ per jaar, en
              met alle maatregelen samen kan dat naar zo’n 5.700 kg.
            </p>
          </div>
        </div>
      </section>

      <section class="lijst-sectie">
        <div class="omhulsel">
          <p class="bovenlabel">Alles op een rij</p>
          <h2>Alle {totaal} dingen</h2>
          <div class="kolommen">
            {perSegment.map((seg) => (
              <details class="segment-kaart" open>
                <summary>
                  <h3>{seg.naam}</h3>
                  <span class="segment-aantal">{seg.items.length}</span>
                </summary>
                {seg.ringen.map((ring) => (
                  <div class="ringgroep">
                    <p class={`ringkop ringkop-${ring.id}`}>{ring.naam}</p>
                    <ul>
                      {ring.items.map((item) => (
                        <li>
                          <button type="button" class="item-knop" data-nr={item.nr}>
                            <span class="item-nr">{item.nr}</span>
                            <span>{item.titel}</span>
                          </button>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </details>
            ))}
          </div>
        </div>
      </section>

      <section id="waarom" class="waarom">
        <div class="omhulsel waarom-binnen">
          <p class="bovenlabel">Maakt het uit?</p>
          <h2>&ldquo;Wat ik doe maakt toch niets uit&rdquo;</h2>
          <div class="waarom-kolommen">
            <div>
              <p>
                Dat hoor je overal, en het is begrijpelijk. Je leest over smeltend ijs en
                afbrandende bossen, en dan sta jij in de supermarkt te twijfelen over een
                pak melk. Dat voelt belachelijk klein.
              </p>
              <p>
                Maar de redenering klopt niet. Niemand vraagt jou om het klimaat in je
                eentje te repareren. Waar het om gaat is dat vrijwel alles op deze radar
                een <strong>keuze in een systeem</strong> is. Biologisch kopen verandert
                niet de wereld, maar het verandert wél wat de boer volgend jaar durft te
                zaaien. Overstappen naar een andere bank verandert waar jouw geld gaat
                liggen. Dat werkt alleen als genoeg mensen het doen. Daarom telt die van
                jou.
              </p>
            </div>
            <div>
              <p>
                En dan het tweede stuk. Duurzaam leven wordt altijd gebracht als iets wat je
                inlevert. Bij mij werkt het andersom, en dat zit hem in de rekensom
                eronder.
              </p>
              <p>
                Alles wat je niet koopt, hoef je ook niet te betalen. Wat je niet hoeft te
                betalen, hoef je niet te verdienen. En wat je niet hoeft te verdienen, hoef
                je niet te werken. Zo simpel is het: minder spullen kopen betekent op termijn
                minder uren maken. Wij sparen en lossen af met wat we niet uitgeven, en dat
                koopt geen boot maar ruimte in de week.
              </p>
              <p>
                Daar komt bij dat zelf koken van je restjes lekkerder is, je eigen tomaten
                beter smaken en fietsen naar je werk de fijnste drie kwartier van de dag is.
              </p>
              <p>
                Wat je terugkrijgt is tijd. Dat is het enige dat je nergens kunt bijkopen.
              </p>
              <p class="waarom-nb">
                In dezelfde geest, en veel beter opgeschreven:
                <em>Intentioneel leven</em> van Ernst-Jan Pfauth.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section id="over" class="over">
        <div class="omhulsel over-binnen">
          <div>
            <p class="bovenlabel">Over mij</p>
            <h2>Wie dit schrijft</h2>
            <p>
              Ik ben Dian. Ik woon met mijn gezin in een koophuis, ik ben geen bioloog en ik
              heb hier geen enkele opleiding voor.
            </p>
            <p>
              Alles op deze radar doe ik zelf, of heb ik geprobeerd en weer losgelaten. De
              wasbare luiers hebben we zes maanden volgehouden. Eerlijk gezegd was dat lang
              niet altijd leuk. En ja, ik vlieg heel af en toe; dat staat er ook gewoon op.
            </p>
            <p>
              Eén ding waar ik eerlijk over wil zijn: dit is de radar van iemand met een
              koophuis en een tuin. Dat is een voorrecht, en je ziet het vooral terug in de
              ring Investeer één keer. Een groen dak, spouwmuurisolatie of een regenton kan ik alleen
              noemen omdat ik toevallig eigenaar ben van de muren. Woon je in een huurhuis
              of een flat, dan valt dat deel weg, en dat is oprecht rot om te lezen als je
              juist dán het gevoel hebt dat je niets kunt.
            </p>
            <p>
              Daarom dit: de twee binnenste ringen zijn helemaal niet afhankelijk van wat
              voor huis je hebt. Dat zijn er {zonderEigenHuis} van de {totaal}. Alles wat je
              eet, koopt, weggooit, verzekert, spaart of zegt telt net zo hard, of je nu
              huurt of koopt. Voor de rest geldt: een verhuurder is verplicht te isoleren,
              en dat vragen is gratis.
            </p>
            <p>
              Dit is bedoeld om je te inspireren, niet om je de les te lezen. Het is
              nadrukkelijk niet de enige waarheid en zeker niet het einde van het lijstje.
              Ik weet vrij zeker dat ik een aantal dingen beter kan doen, en er staan vast
              zaken tussen waar iemand anders een betere oplossing voor heeft gevonden. Ik
              leer graag bij, dus weet je iets wat hier nog niet staat: laat het me weten.
            </p>
            <p>
              Deze site is een privéproject. Ik heb hem in eigen tijd gemaakt, er is niets
              van mijn werk voor gebruikt, en het is niet het standpunt van mijn werkgever.
              Er wordt niets aan verdiend en er staat geen advertentie op. De bedrijven die
              ik noem betalen daar niet voor; het is gewoon wat er bij mij in de kast staat.
              Cijfers en beweringen komen natuurlijk wél ergens vandaan, en die bron staat
              bij het item zelf.
            </p>
            <p>
              Mis je iets, of doe je thuis iets wat hier nog niet staat? De site is open
              source. Stuur gerust een pull request.
            </p>
            <div class="koffie">
              <h3>Ben je geïnspireerd?</h3>
              <p>
                Trakteer me dan op een bakkie koffie. Daar betaal ik het domein van, en
                verder is het gewoon leuk als er af en toe iets binnenkomt. Een verdienmodel
                komt er niet, dat houd ik zo.
              </p>
              <a
                class="knop"
                href="https://bunq.me/watjezelfkuntdoen"
                target="_blank"
                rel="noopener noreferrer"
              >
                Trakteer me op een koffie
              </a>
            </div>
          </div>
          <aside class="colofon">
            <h3>Colofon</h3>
            <p>
              Deze radar telt {totaal} items, verdeeld over acht thema&rsquo;s en vier ringen:
              {telling.map((r, i) => (
                <>{i > 0 ? ', ' : ''}<strong>{r.aantal}</strong> × {r.kort.toLowerCase()}</>
              ))}.
            </p>
            <p>
              Waar ik een getal of een bewering noem, hoort daar een bron bij. Klik een item
              open en je vindt hem onderaan. Kom je iets tegen dat niet klopt of achterhaald
              is, zeg het vooral. Liever iets minder stellig dan iets wat niet klopt.
            </p>
          </aside>
        </div>
      </section>
    </main>

    <footer class="voet">
      <div class="omhulsel">
        <p>Wat je zelf kunt doen. Een privéproject, gemaakt met veel groen en weinig javascript.</p>
      </div>
    </footer>

    <script type="application/json" id="radar-data" set:html={JSON.stringify(detailData)} />

    <script>
      const data = JSON.parse(document.getElementById('radar-data').textContent);
      const perNr = new Map(data.map((d) => [String(d.nr), d]));
      const detail = document.getElementById('detail');
      const svg = document.querySelector('.radar');
      const blips = [...document.querySelectorAll('.blip')];
      const itemKnoppen = [...document.querySelectorAll('.item-knop')];
      const smal = () => window.matchMedia('(max-width: 760px)').matches;

      function el(tag, klasse, tekst) {
        const n = document.createElement(tag);
        if (klasse) n.className = klasse;
        if (tekst) n.textContent = tekst;
        return n;
      }

      function toon(nr) {
        const d = perNr.get(String(nr));
        if (!d) return;

        detail.textContent = '';

        const knoppen = el('div', 'detail-knoppen');

        const deel = el('button', 'detail-deel', 'Kopieer link');
        deel.type = 'button';
        deel.addEventListener('click', async () => {
          const url = `${location.origin}${location.pathname}#item-${d.nr}`;
          try {
            if (navigator.share && smal()) {
              await navigator.share({ title: d.titel, url });
              return;
            }
            await navigator.clipboard.writeText(url);
            deel.textContent = 'Gekopieerd';
          } catch {
            deel.textContent = url;
          }
          setTimeout(() => {
            deel.textContent = 'Kopieer link';
          }, 2200);
        });
        knoppen.append(deel);

        const sluit = el('button', 'detail-sluit', 'Sluiten');
        sluit.type = 'button';
        sluit.addEventListener('click', () => {
          detail.classList.remove('open');
          blips.forEach((b) => b.classList.remove('actief'));
          itemKnoppen.forEach((k) => k.classList.remove('actief'));
          history.replaceState(null, '', location.pathname + location.search);
        });
        knoppen.append(sluit);
        detail.append(knoppen);

        const kruimel = el('p', 'detail-kruimel');
        kruimel.append(el('span', 'detail-nr', String(d.nr)));
        kruimel.append(el('span', null, `${d.segment} · ${d.ringNaam}`));
        detail.append(kruimel);

        detail.append(el('h3', null, d.titel));
        detail.append(el('p', 'detail-tekst', d.tekst));

        if (d.waarom) {
          const meer = el('details', 'detail-waarom');
          meer.append(el('summary', null, 'Waarom dit uitmaakt'));
          d.waarom.split('\n\n').forEach((alinea) => meer.append(el('p', null, alinea)));
          detail.append(meer);
        }

        if (d.links.length) {
          const rij = el('p', 'detail-links');
          d.links.forEach((l, i) => {
            if (i > 0) rij.append(document.createTextNode(' · '));
            const a = el('a', null, l.tekst);
            a.href = l.url;
            a.target = '_blank';
            a.rel = 'noopener noreferrer';
            rij.append(a);
          });
          detail.append(rij);
        }

        detail.classList.add('open');
        blips.forEach((b) => b.classList.toggle('actief', b.dataset.nr === String(nr)));
        itemKnoppen.forEach((k) => k.classList.toggle('actief', k.dataset.nr === String(nr)));
        history.replaceState(null, '', `#item-${d.nr}`);
      }

      // Een item is los deelbaar: watjezelfkuntdoen.nl/#item-18 opent dat item.
      function uitHash() {
        const treffer = /^#item-(\d+)$/.exec(location.hash);
        if (!treffer) return;
        const nr = treffer[1];
        if (!perNr.has(nr)) return;
        toon(nr);
        document.getElementById('radar').scrollIntoView({ block: 'start' });
      }

      uitHash();
      window.addEventListener('hashchange', uitHash);

      blips.forEach((b) => {
        b.addEventListener('click', () => toon(b.dataset.nr));
        b.addEventListener('mouseenter', () => {
          if (!smal()) toon(b.dataset.nr);
        });
        b.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            toon(b.dataset.nr);
          }
        });
        b.addEventListener('focus', () => toon(b.dataset.nr));
      });

      itemKnoppen.forEach((k) => {
        k.addEventListener('click', () => {
          toon(k.dataset.nr);
          if (!smal()) {
            document.getElementById('radar').scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      });

      // Ringen filteren via de legenda
      let filter = null;
      document.querySelectorAll('[data-ringfilter]').forEach((knop) => {
        knop.addEventListener('click', () => {
          const ring = knop.dataset.ringfilter;
          filter = filter === ring ? null : ring;
          svg.classList.toggle('gefilterd', filter !== null);
          document.querySelectorAll('[data-ringfilter]').forEach((k) => {
            const aan = k.dataset.ringfilter === filter;
            k.classList.toggle('aan', aan);
            k.setAttribute('aria-pressed', String(aan));
          });
          blips.forEach((b) =>
            b.classList.toggle('zichtbaar', filter === null || b.dataset.ring === filter)
          );
          document.querySelectorAll('.wiggen path').forEach((p) => {
            if (filter && p.dataset.ring === filter) p.setAttribute('data-actief', '');
            else p.removeAttribute('data-actief');
          });
        });
      });

      // Op een telefoon beginnen de themablokken dicht, anders is die lijst
      // eindeloos scrollen. Op een groot scherm staan ze gewoon open.
      const themaBlokken = [...document.querySelectorAll('.segment-kaart')];
      const stelThemaBlokkenIn = () => {
        themaBlokken.forEach((blok) => {
          blok.open = !smal();
        });
      };
      stelThemaBlokkenIn();
      window
        .matchMedia('(max-width: 760px)')
        .addEventListener('change', stelThemaBlokkenIn);
    </script>

